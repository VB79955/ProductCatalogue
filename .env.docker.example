APP_NAME="Product Catalogue"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=catalogue
DB_USERNAME=catalogue
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CATALOG_PROVIDER=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
CATALOG_CACHE_TTL=3600
CATALOG_FEATURED_LIMIT=5

ENQUIRY_ADMIN_EMAIL="${MAIL_FROM_ADDRESS}"
ENQUIRY_QUEUE_CONNECTION=redis

API_RATE_LIMIT=60
API_RATE_LIMIT_STRICT=10

HORIZON_ENABLED=true

MESSAGE_BUS=laravel_queue
SEARCH_DRIVER=null

RESILIENCE_FAILURE_THRESHOLD=5
RESILIENCE_OPEN_SECONDS=60
